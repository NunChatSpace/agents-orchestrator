# Database
DATABASE_URL=postgres://oagent:secret@localhost:5432/oagent?sslmode=disable

# Session (must be exactly 32 bytes)
SESSION_SECRET=changeme32byteslongsecretkey1234

# Seed user (created on first startup if not exists)
SEED_USERNAME=admin
SEED_PASSWORD=changeme

# Server
PORT=8080
LOG_LEVEL=info

# CORS — frontend origin
FRONTEND_ORIGIN=http://localhost:5173

# OAgent callback base (what WAgents use to reach the backend)
# In Docker: http://backend:8080   On host: http://localhost:8080
OAGENT_CALLBACK_BASE=http://backend:8080

# ---------------------------------------------------------------------------
# WAgent CLI keys — used by wagent/main.py
# AUTH_KEY raw value must satisfy: sha256(AUTH_KEY) == api_key_hash in DB
# Migration 003 sets api_key_hash = sha256('dev-key-<worker-name>')
# Change these values in production (rerun migration 003 after changing).
# ---------------------------------------------------------------------------
# AUTH_KEY=dev-key-fi-backend1   (set per-container in docker-compose)

# CLI agent API keys (passed through to WAgent containers)
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

GIT_TOKEN=

# workspace path on host, mounted into WAgent containers at /workspaces (migration 004 sets worker.workspace = /workspaces/<name>)
WORKSPACES_PATH=